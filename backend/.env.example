APP_NAME="Hotel Platform"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_LOCALES=en,ar

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hotel_platform
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Payment (Phase 5). "dummy" is the only supported provider in this phase.
# PAYMENT_CURRENCY is intentionally left unset — no business currency is chosen yet.
OTP_SENDER=dummy
# Development only — makes every generated guest OTP this value so the Flutter
# app can walk the flow without real SMS. MUST be left unset in staging/production.
OTP_FIXED_CODE=123456
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=42
OTP_MAX_RESENDS=3
OTP_REQUEST_RATE_LIMIT=5
OTP_VERIFY_RATE_LIMIT=10

PAYMENT_PROVIDER=dummy
PAYMENT_CURRENCY=
PAYMENT_DUMMY_WEBHOOK_SECRET=
PAYMENT_DUMMY_DEFAULT_DIRECTIVE=success
PAYMENT_HOLD_RATE_LIMIT=30
PAYMENT_WEBHOOK_RATE_LIMIT=300

# Guest deposit-hold rule (config/guest_booking.php -> deposit). Defaults to
# a 20% hold on the reservation's price_snapshot if left unset — a
# placeholder pending business sign-off on the exact percentage. Set
# GUEST_BOOKING_DEPOSIT_RULE= (empty) to disable guest deposit holds again.
GUEST_BOOKING_DEPOSIT_RULE=percentage
GUEST_BOOKING_DEPOSIT_PERCENTAGE=20

# Identity Verification (Phase 6). "dummy" is the only supported provider in
# this phase. The threshold / retry-limit / retention values are
# intentionally left UNSET — Phase 0 §20 items 2, 3 and 5 are genuinely
# unresolved business values and no number is invented. While unset, the
# workflow fails safe to PENDING_MANUAL_REVIEW (never auto-approve/reject)
# and no retention purge job runs.
IDENTITY_PROVIDER=dummy
IDENTITY_DUMMY_DEFAULT_DIRECTIVE=high_match
IDENTITY_VERIFICATION_AUTO_APPROVE_THRESHOLD=
IDENTITY_VERIFICATION_MANUAL_REVIEW_THRESHOLD=
IDENTITY_VERIFICATION_MAX_RETRIES=
IDENTITY_VERIFICATION_RETENTION_DAYS=
IDENTITY_VERIFICATION_DISK=local
IDENTITY_VERIFICATION_MAX_FILE_KB=8192
IDENTITY_VERIFICATION_SUBMIT_RATE_LIMIT=20

# Digital Access + Check-in (Phase 7). "dummy" is the only supported provider
# in this phase. Access expiry is NOT a configurable duration — it is derived
# from the reservation's check_out date (Phase 0 §11 "stay end reached").
DIGITAL_ACCESS_PROVIDER=dummy
DIGITAL_ACCESS_MODE=pin_code
DIGITAL_ACCESS_DUMMY_DEFAULT_DIRECTIVE=success
DIGITAL_ACCESS_CHECKIN_RATE_LIMIT=20
DIGITAL_ACCESS_REVOKE_RATE_LIMIT=20

# Stay Services + Folio (Phase 8). No provider, no external integration —
# services are an internal catalog and folio charges are internal financial
# records. Service pricing is simple (one price per service); no currency is
# defaulted (mirrors PAYMENT_CURRENCY).

# Checkout + Final Settlement + Invoice (Phase 9). Final settlement reuses the
# Phase 5 payment gateway (PAYMENT_PROVIDER). No invoice numbering scheme is
# defined by the business — a technical INV-<id> format is used. No currency
# is defaulted; a settlement with no resolvable currency fails safely.
CHECKOUT_PERFORM_RATE_LIMIT=12

# Loyalty (Phase 10). No env config — the earn/redeem rates and the on/off
# switch live in `loyalty_rules`, one row per hotel group, configured by a
# Group Owner. Nothing is seeded or defaulted (Phase 0 §13); loyalty is OFF
# for a group until a rule is activated with an earn rate.

# Notifications (Phase 11). "dummy" is the only supported provider in this
# phase — it records a notification internally and makes NO external call
# (Phase 0 §15). No email/SMS/push SDK or credential is introduced. The dummy
# directive is "deliver" (success) or "fail" (deterministic failure branch
# for tests). NOTIFICATION_LOCALE is intentionally left unset — there is no
# per-guest locale field yet, so rendering falls back to APP_LOCALE.
NOTIFICATION_PROVIDER=dummy
NOTIFICATION_DUMMY_DEFAULT_DIRECTIVE=deliver
NOTIFICATION_LOCALE=
NOTIFICATIONS_READ_RATE_LIMIT=60

VITE_APP_NAME="${APP_NAME}"
