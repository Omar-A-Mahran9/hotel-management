	"item": [
		{
			"name": "Authentication",
			"item": [
				{
					"name": "Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"var jsonData = pm.response.json();",
									"",
									"pm.test(\"Response follows the standard success envelope\", function () {",
									"    pm.expect(jsonData).to.have.property(\"success\", true);",
									"    pm.expect(jsonData).to.have.property(\"message\");",
									"    pm.expect(jsonData.data).to.have.property(\"user\");",
									"    pm.expect(jsonData.data).to.have.property(\"token\");",
									"});",
									"",
									"pm.test(\"Access token is present and saved to {{access_token}}\", function () {",
									"    pm.expect(jsonData.data.token).to.be.a(\"string\").and.to.have.lengthOf.above(0);",
									"    pm.environment.set(\"access_token\", jsonData.data.token);",
									"});",
									"",
									"pm.test(\"Logged-in user profile includes role\", function () {",
									"    pm.expect(jsonData.data.user).to.have.property(\"role\");",
									"    pm.expect(jsonData.data.user.role).to.have.property(\"slug\");",
									"});"
								]
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"owner@example.com\",\n    \"password\": \"password\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/auth/login",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"auth",
								"login"
							]
						},
						"description": "Authenticates a staff user (Group Owner / Hotel Manager / Reception) via App\\Http\\Controllers\\Api\\V1\\AuthController::login. Body validated by LoginRequest: email (required, string, email:filter), password (required, string). On success, issues a Sanctum bearer token and saves it to {{access_token}}.\n\nThe seeded local Group Owner (php artisan db:seed, local environment only) is owner@example.com / password — adjust to a real account for other environments."
					},
					"response": []
				},
				{
					"name": "Get Authenticated User (Me)",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"var jsonData = pm.response.json();",
									"",
									"pm.test(\"Returns the authenticated user's own profile\", function () {",
									"    pm.expect(jsonData.success).to.eql(true);",
									"    pm.expect(jsonData.data).to.have.property(\"id\");",
									"    pm.expect(jsonData.data).to.have.property(\"email\");",
									"    pm.expect(jsonData.data).to.have.property(\"role\");",
									"    pm.expect(jsonData.data.role).to.have.property(\"permissions\");",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/auth/me",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"auth",
								"me"
							]
						},
						"description": "Returns the authenticated user's own profile (App\\Http\\Controllers\\Api\\V1\\AuthController::me), including role, the role's permissions, and hotel access. Requires auth:sanctum."
					},
					"response": []
				},
				{
					"name": "Logout",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"var jsonData = pm.response.json();",
									"",
									"pm.test(\"Logout success envelope\", function () {",
									"    pm.expect(jsonData.success).to.eql(true);",
									"    pm.expect(jsonData.data).to.eql(null);",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{base_url}}/auth/logout",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"auth",
								"logout"
							]
						},
						"description": "Revokes the current Sanctum access token (App\\Http\\Controllers\\Api\\V1\\AuthController::logout). Requires auth:sanctum. After this call, {{access_token}} is no longer valid — run Login again before further requests."
