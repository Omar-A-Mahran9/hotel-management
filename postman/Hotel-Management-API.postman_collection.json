					},
					"response": []
				},
				{
					"name": "Create User",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"type": "text/javascript",
								"exec": [
									"// Ensures {{role_id}} is populated even if the \"List Roles\" request",
									"// (under Roles & Permissions) has not been run yet in this session,",
									"// by calling the existing GET /roles endpoint directly.",
									"if (!pm.environment.get(\"role_id\")) {",
									"    pm.sendRequest({",
									"        url: pm.environment.get(\"base_url\") + \"/roles\",",
									"        method: \"GET\",",
									"        header: {",
									"            Accept: \"application/json\",",
									"            Authorization: \"Bearer \" + pm.environment.get(\"access_token\")",
									"        }",
									"    }, function (err, res) {",
									"        if (!err && res.code === 200) {",
									"            var body = res.json();",
									"            var roles = body.data || [];",
									"            var hotelManager = roles.find(function (r) { return r.slug === \"hotel_manager\"; });",
									"            var role = hotelManager || roles[0];",
									"            if (role) {",
									"                pm.environment.set(\"role_id\", role.id);",
									"            }",
									"        }",
									"    });",
									"}"
								]
							}
						},
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"Status code is 201\", function () {",
									"    pm.response.to.have.status(201);",
									"});",
									"",
									"var jsonData = pm.response.json();",
									"",
									"pm.test(\"Created user returned with role and hotel access\", function () {",
									"    pm.expect(jsonData.success).to.eql(true);",
									"    pm.expect(jsonData.message).to.eql(\"Created successfully.\");",
									"    pm.expect(jsonData.data).to.have.property(\"id\");",
									"    pm.expect(jsonData.data).to.have.property(\"role\");",
									"    pm.expect(jsonData.data).to.have.property(\"hotels\");",
									"});",
									"",
									"pm.test(\"user_id saved for later requests\", function () {",
									"    pm.environment.set(\"user_id\", jsonData.data.id);",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"name\": \"Manager A\",\n    \"email\": \"manager-a@example.com\",\n    \"password\": \"password123\",\n    \"role_id\": {{role_id}},\n    \"hotel_ids\": [{{hotel_id}}]\n}"
						},
						"url": {
							"raw": "{{base_url}}/users",
							"host": [
								"{{base_url}}"
							],
							"path": [
